# ตอนพัฒนาใช้ไฟล์ SQLite ในเครื่อง / ตอน deploy ใช้ URL ของ Turso (libsql://...)
DATABASE_URL=file:local.db
# ใช้เฉพาะตอนต่อ Turso
DATABASE_AUTH_TOKEN=
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# พร้อมเพย์ของร้านสำหรับรับมัดจำ (เบอร์มือถือ / เลขบัตรประชาชน)
PROMPTPAY_ID=0812345678
